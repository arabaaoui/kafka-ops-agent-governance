# =============================================================================
# Kafka Ops Agent Governance — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The defaults below match kafka/admin.properties and kafka/agent.properties —
# regenerate those two files if you change either password.
# =============================================================================

# --- Kafka broker identities (SASL_PLAINTEXT/PLAIN, local dev only) --------
# Two separate principals — never share credentials between them:
#   admin                used by problem-injector and the ACL/topic bootstrap.
#                         Super user: bypasses ACL checks entirely.
#   diagnostic-agent-ro   used by mcp-confluent AND the diagnostic agent's own
#                         direct producer. Granted only Describe/Read on
#                         'factures' and 'facturation', Describe/Read on all
#                         consumer groups (see kafka/init-acls.sh for why),
#                         and Describe/Write on 'incidents'. Nothing else.
KAFKA_ADMIN_SASL_PASSWORD=admin-secret
KAFKA_AGENT_SASL_PASSWORD=agent-secret

# --- Diagnostic Agent LLM — OPTIONAL --------------------------------------
# The Diagnostic Agent is a real google-adk Agent, routed through LiteLLM.
# Supported providers: openai, anthropic, gemini (see agents/common/adk_factory.py)
#
# Leave DIAGNOSTIC_LLM_API_KEY empty to run the agent on its deterministic
# fallback (no LLM call at all — the same get_consumer_lag / read_from_offset /
# diagnose tools are called directly, in order, producing the same result).
DIAGNOSTIC_LLM_PROVIDER=openai
DIAGNOSTIC_LLM_MODEL=gpt-4o
DIAGNOSTIC_LLM_API_KEY=

# --- Kafka / MCP endpoints (defaults match docker-compose.*.yml) -----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
MCP_CONFLUENT_URL=http://mcp-confluent:3000
